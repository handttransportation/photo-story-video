# SQLite database file (no external DB server needed)
DATABASE_URL="file:./dev.db"

# Which video-generation backend to use: "replicate" (real AI video, default)
# or "mock" (a local ffmpeg pan/zoom fixture, clearly watermarked "TEST RENDER —
# NOT AI-GENERATED", used to exercise the rest of the app — upload, AI Director,
# planning, timeline, audio sync, ffmpeg assembly, export — without spending
# Replicate credit). Switching this is the ONLY change needed to go from test
# mode to real generation; nothing else in the app needs to change.
VIDEO_PROVIDER="replicate"

# REQUIRED (when VIDEO_PROVIDER=replicate) for real video generation.
# Get a key at https://replicate.com/account/api-tokens. Replicate is pay-per-use
# but requires credit/a payment method on the account before it will run anything.
# Without this, uploads/analysis/planning work but "Create Video" will fail with
# a clear error instead of producing a fake/placeholder video.
REPLICATE_API_TOKEN=

# Which Replicate image-to-video model to use (owner/name of an "official model").
# Default targets Minimax's camera-direction model (confirmed working: accepts
# `first_frame_image` + `prompt`). Swap this to change providers/models without
# touching code, as long as the model accepts an image + a text prompt.
REPLICATE_VIDEO_MODEL="minimax/video-01-director"

# OPTIONAL. Powers the "AI Director" photo analysis (subject/mood/sequencing) using
# Claude's vision model. Get a key at https://console.anthropic.com/settings/keys.
# Without it, the app falls back to a heuristic analyzer (still functional, less smart).
ANTHROPIC_API_KEY=
