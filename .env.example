# SQLite database file (no external DB server needed)
DATABASE_URL="file:./dev.db"

# REQUIRED for real video generation.
# Get a key at https://replicate.com/account/api-tokens (pay-per-use, no subscription).
# Without this, uploads/analysis/planning work but "Create Video" will fail with
# a clear error instead of producing a fake/placeholder video.
REPLICATE_API_TOKEN=

# Which Replicate image-to-video model to use (owner/name of an "official model").
# Default targets Minimax's camera-direction model. Swap this to change providers
# without touching code, as long as the model accepts an image + text prompt.
REPLICATE_VIDEO_MODEL="minimax/video-01-director"

# OPTIONAL. Powers the "AI Director" photo analysis (subject/mood/sequencing) using
# Claude's vision model. Get a key at https://console.anthropic.com/settings/keys.
# Without it, the app falls back to a heuristic analyzer (still functional, less smart).
ANTHROPIC_API_KEY=
